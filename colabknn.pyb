    {
      "cell_type": "code",
      "source": [
        "import math\n",
        "def get_distance_math(point1, point2):\n",
        "    # Returns the Euclidean distance between two N-dimensional points\n",
        "    return math.dist(point1, point2)\n"
      ],
      "metadata": {
        "id": "CCcIastKiWkh"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import collections\n",
        "\n",
        "#impementing knn predictor\n",
        "def predict(new_HEIGHT, new_WEIGHT, k=3):\n",
        " new_point=[new_HEIGHT, new_WEIGHT]\n",
        " distances=[]\n",
        " for i in range(len(x)):\n",
        "    distance=get_distance_math(new_point, x.iloc[i])\n",
        "    distances.append((distance,y[i]))\n",
        " distances.sort()\n",
        " K_nearest=distances[:k]\n",
        " K_lables=[lable for(distance,lable) in K_nearest]\n",
        " prediction=collections.Counter(K_lables).most_common(1)[0][0]\n",
        " return prediction"
      ],
      "metadata": {
        "id": "mtZX-mo_m8QN"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#doing the actual prediction\n",
        "\n",
        "predict(170,72,3)"
      ],
