    {
      "cell_type": "code",
      "source": [
        "#selecting features and lables\n",
        "DatasetHWR_data\n",
        "x=DatasetHWR_data[['HEIGHT','WEIGHT']]\n",
        "y=DatasetHWR_data['REMARKS']\n",
        "print(x)\n",
        "print(y)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "nT7Kz58DYY2K",
        "outputId": "aaa515bc-5f1c-461f-da22-7d3d9f6de0bd"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "   HEIGHT  WEIGHT\n",
            "0     170      65\n",
            "1     185      85\n",
            "2     160      55\n",
            "3     178      75\n",
            "0     no\n",
            "1    yes\n",
            "2     no\n",
            "3    yes\n",
            "Name: REMARKS, dtype: object\n"
          ]
        }
